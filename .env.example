# ============================================
# IDSS Configuration (.env.example)
# 
# Hướng dẫn: 
# 1. Copy file này thành '.env' (không có .example)
# 2. Điền thông tin cần thiết
# 3. KHÔNG COMMIT .env lên GitHub
# ============================================

# ============= LLM Configuration =============
# Sử dụng OpenAI GPT-4
OPENAI_API_KEY=sk-xxx-your-openai-key-here-xxx
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# (Tuỳ chọn) Sử dụng mã nguồn mở: LLaMA thông qua Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# (Tuỳ chọn) Hugging Face API
# HUGGINGFACE_API_KEY=hf_xxx-your-hf-key-xxx

# ============= Slack Integration =============
SLACK_BOT_TOKEN=xoxb-xxx-your-slack-bot-token-xxx
SLACK_SIGNING_SECRET=xxx-your-slack-signing-secret-xxx

# Slack workspace test (nếu có)
# SLACK_WORKSPACE_ID=T12345ABCDE
# SLACK_CHANNEL_ID=C12345ABCDE

# ============= Teams Integration (tuỳ chọn) =============
# TEAMS_BOT_ID=xxx-your-teams-bot-id-xxx
# TEAMS_BOT_PASSWORD=xxx-your-teams-bot-password-xxx

# ============= Database Configuration =============
# Development: SQLite
DATABASE_URL=sqlite:///./idss_local.db

# Production: PostgreSQL (khi triển khai thực tế)
# DATABASE_URL=postgresql://user:password@localhost:5432/idss_db

# ============= Data Paths =============
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
VECTOR_DB_PATH=./data/vector_db
LOGS_PATH=./logs

# ============= Vector Database =============
# Sử dụng FAISS (local)
VECTOR_DB_TYPE=faiss

# (Tuỳ chọn) Sử dụng Pinecone (cloud)
# VECTOR_DB_TYPE=pinecone
# PINECONE_API_KEY=xxx-your-pinecone-key-xxx
# PINECONE_INDEX_NAME=idss-index

# ============= Embedding Model =============
# Sử dụng OpenAI Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# (Tuỳ chọn) Sử dụng mã nguồn mở: sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============= Logging =============
LOG_LEVEL=INFO
# Tuỳ chọn: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FORMAT=json
# Tuỳ chọn: json, text

ENABLE_ACTIVITY_LOGGING=true
# Ghi nhật ký hoạt động để tuân thủ Luật AI

# ============= System Configuration =============
# Số lượng mẫu tương tự truy xuất
TOP_K_RETRIEVAL=3

# Tối đa tokens cho LLM response
MAX_TOKENS=1000

# Timeout cho API call (giây)
API_TIMEOUT=30

# ============= Development vs Production =============
ENVIRONMENT=development
# Tuỳ chọn: development, staging, production

DEBUG=true

# ============= Web Dashboard (Streamlit) =============
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ============= API Server (FastAPI) =============
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8000
API_WORKERS=4

# ============= Email Notification (tuỳ chọn) =============
# EMAIL_ENABLED=false
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@idss.local

# ============= AWS/GCP Configuration (triển khai đám mây) =============
# (Tuỳ chọn) S3 cho lưu trữ file
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_S3_BUCKET=idss-data-bucket

# (Tuỳ chọn) Google Cloud
# GCP_PROJECT_ID=your-gcp-project
# GCP_CREDENTIALS_PATH=/path/to/credentials.json

# ============= Monitoring (tuỳ chọn) =============
# DATADOG_API_KEY=xxx
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============= Compliance & Audit =============
COMPLIANCE_RISK_LEVEL=low
# Tuỳ chọn: low, medium, high

AUDIT_RETENTION_DAYS=365
# Lưu nhật ký kiểm toán trong bao nhiêu ngày

# ============= Model Fine-tuning (nâng cao) =============
# ENABLE_FINE_TUNING=false
# FINE_TUNE_DATASET_PATH=./data/fine_tune
